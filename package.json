{
  "name": "ai-translate",
  "description": "Vue extension starter for Chrome and Firefox",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt --browser chrome --mv3",
    "dev:firefox": "wxt --browser firefox --mv3",
    "build": "wxt build --browser chrome --mv3",
    "build:firefox": "wxt build --browser firefox --mv3",
    "build:all": "npm run build && npm run build:firefox",
    "zip": "wxt zip --browser chrome --mv3",
    "zip:firefox": "wxt zip --browser firefox --mv3",
    "typecheck": "vue-tsc --noEmit",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@wxt-dev/module-vue": "^1.0.0",
    "typescript": "^5.9.0",
    "vue-tsc": "^3.0.0",
    "wxt": "^0.21.4"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
